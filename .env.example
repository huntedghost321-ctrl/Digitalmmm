# --- Supabase (required for auth, database, storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the Stripe webhook and GDPR delete handler. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI generation (required for the generators) ---
ANTHROPIC_API_KEY=

# --- Stripe (required for paid plans; cards + Google Pay via Checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPPORT_EMAIL=support@digitalmmm.com

# --- Trustpilot widget (optional; the reviews section hides until configured) ---
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_ID=
NEXT_PUBLIC_TRUSTPILOT_TEMPLATE_ID=
